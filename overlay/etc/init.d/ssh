#!/bin/sh
# openkobo replacement for /etc/init.d/ssh (called from rcS).
#
# Differences from the stock script:
#   1. Stock Kobos all ship the same SSH host keys. Here the host key is one
#      you generate for this device (the firmware has no ssh-keygen) and keep
#      on the user partition.
#   2. The stock script blanks the root password and the stock sshd_config
#      permits empty-password root login. Here login is key-only, and sshd
#      does not start until a public key is installed.
#
# To enable, over USB:
#   .kobo/openkobo/ssh/ssh_host_ed25519_key   host private key for this device
#   .kobo/openkobo/authorized_keys            your public key(s)
#   .kobo/ssh-enabled                         empty file
# then reboot and: ssh root@<device_ip>

SSH_ENABLED_FILE=/mnt/onboard/.kobo/ssh-enabled
SSH_DISABLED_FILE=/mnt/onboard/.kobo/ssh-disabled
OK_DIR=/mnt/onboard/.kobo/openkobo
HOST_KEY=${OK_DIR}/ssh/ssh_host_ed25519_key
AUTH_KEYS=${OK_DIR}/authorized_keys
RUN_DIR=/tmp/openkobo
SSHD_CONFIG=/etc/ssh/sshd_config

if [ ! -e "${SSH_ENABLED_FILE}" ]; then
	if [ ! -e "${SSH_DISABLED_FILE}" ]; then
		{
			echo "To enable ssh:"
			echo "- Put a host key for this device at ${HOST_KEY}"
			echo "- Put your SSH public key at ${AUTH_KEYS}"
			echo "- Rename this file to ssh-enabled"
			echo "- Reboot, then connect with: ssh root@<device_ip>"
		} > "${SSH_DISABLED_FILE}"
	fi
	echo "NOT starting sshd (disabled)"
	exit 0
fi

# Never fall back to the shared stock host keys or to passwords.
if [ ! -s "${HOST_KEY}" ]; then
	echo "NOT starting sshd: no host key at ${HOST_KEY}"
	exit 0
fi
if [ ! -s "${AUTH_KEYS}" ]; then
	echo "NOT starting sshd: no public key at ${AUTH_KEYS}"
	exit 0
fi

[ ! -d /var/empty ] && mkdir -p /var/empty && chmod 755 /var/empty
[ ! -d /dev/pts ] && mkdir -p /dev/pts
/bin/mount -t devpts none /dev/pts -o mode=0620 2>/dev/null
grep -q '^sshd:' /etc/group 2>/dev/null || addgroup --gid 999 sshd 2>/dev/null

# sshd requires a 0600 host key, which the FAT user partition cannot provide,
# and the partition is unmounted while USB is connected, so stage copies in
# tmpfs each boot.
rm -rf "${RUN_DIR}"
mkdir -p "${RUN_DIR}/ssh"
chmod 700 "${RUN_DIR}" "${RUN_DIR}/ssh"
cp "${HOST_KEY}" "${RUN_DIR}/ssh/ssh_host_ed25519_key"
cp "${AUTH_KEYS}" "${RUN_DIR}/authorized_keys"
chmod 600 "${RUN_DIR}/ssh/ssh_host_ed25519_key" "${RUN_DIR}/authorized_keys"

echo "Starting sshd (key-only root login)"
/usr/sbin/sshd -f "${SSHD_CONFIG}"
