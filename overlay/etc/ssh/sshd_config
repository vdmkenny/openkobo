# openkobo sshd_config. Replaces the stock config, which allowed
# empty-password root login (PermitRootLogin yes / PermitEmptyPasswords yes).
# Root login is key-only. The host key is the device's own, staged in tmpfs by
# /etc/init.d/ssh at boot (never the keys shared by every stock Kobo).

HostKey /tmp/openkobo/ssh/ssh_host_ed25519_key

PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no

AuthorizedKeysFile /tmp/openkobo/authorized_keys
AllowUsers root

# StrictModes rejects authorized_keys unless every parent directory up to / is
# root-owned and not group/world-writable. On a Kobo that never holds: the
# firmware update sets / to 0775 owned by uid 1000, and /tmp is a 1777 tmpfs.
# init.d/ssh stages the file 0600 in a 0700 root-only directory instead.
StrictModes no

AllowTcpForwarding no
X11Forwarding no
PermitTunnel no

ClientAliveInterval 15
ClientAliveCountMax 4
Compression no

Subsystem sftp internal-sftp
